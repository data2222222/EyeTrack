{
  "manifest_version": 3,
  "name": "Study Focus Collector",
  "version": "1.0",
  "description": "Sends the active tab's domain and browser activity to the local Study Focus engine.",
  "permissions": ["tabs", "activeTab", "idle", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Study Focus" }
}
